{
    "openapi": "3.0.0",
    "info": {
        "title": "RegMail API",
        "description": "API for RegMail - Email Registration Service",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Development Server"
        }
    ],
    "paths": {
        "/api/app/version/check": {
            "get": {
                "tags": [
                    "App Version Management"
                ],
                "summary": "Check for app version updates",
                "description": "Check if a newer version of the app is available by comparing version codes",
                "operationId": "5d18d94bc85c58ed7cfb5804a8ea6765",
                "parameters": [
                    {
                        "name": "current_version_code",
                        "in": "query",
                        "description": "Current version code of the app (integer, e.g., 100 for version 1.0.0)",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 100
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Version check result",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "needs_update": {
                                                    "description": "Whether an update is available",
                                                    "type": "boolean",
                                                    "example": true
                                                },
                                                "force_update": {
                                                    "description": "Whether update is forced (users must update)",
                                                    "type": "boolean",
                                                    "example": false
                                                },
                                                "latest_version": {
                                                    "description": "Latest version string",
                                                    "type": "string",
                                                    "example": "1.2.0"
                                                },
                                                "latest_version_code": {
                                                    "description": "Latest version code",
                                                    "type": "integer",
                                                    "example": 120
                                                },
                                                "current_version_code": {
                                                    "description": "Current version code from request",
                                                    "type": "integer",
                                                    "example": 100
                                                },
                                                "download_url": {
                                                    "description": "URL to download the update (null if no update needed)",
                                                    "type": "string",
                                                    "example": "/api/app/version/download/1"
                                                },
                                                "release_notes": {
                                                    "description": "Release notes for the update",
                                                    "type": "string",
                                                    "example": "Bug fixes and performance improvements"
                                                },
                                                "file_size": {
                                                    "description": "File size in bytes",
                                                    "type": "integer",
                                                    "example": 5242880
                                                },
                                                "checksum": {
                                                    "description": "SHA256 checksum for file verification",
                                                    "type": "string",
                                                    "example": "a1b2c3d4e5f6..."
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Invalid version code",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Invalid version code"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/app/version/download/{id}": {
            "get": {
                "tags": [
                    "App Version Management"
                ],
                "summary": "Download app version file",
                "description": "Download the executable file for a specific app version. Only active versions are available for download.",
                "operationId": "9a306ada6b6e9d9fce615810d8614c0c",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "Version ID to download",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "File download",
                        "content": {
                            "application/octet-stream": {
                                "schema": {
                                    "type": "string",
                                    "format": "binary"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Version not found or not available",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Version is not available for download"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/app/version/info": {
            "get": {
                "tags": [
                    "App Version Management"
                ],
                "summary": "Get latest version information",
                "description": "Get information about the latest active app version without checking for updates",
                "operationId": "74ff2d14d2484930857253064d00883e",
                "responses": {
                    "200": {
                        "description": "Latest version information",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "data": {
                                            "properties": {
                                                "version": {
                                                    "description": "Version string",
                                                    "type": "string",
                                                    "example": "1.2.0"
                                                },
                                                "version_code": {
                                                    "description": "Version code for comparison",
                                                    "type": "integer",
                                                    "example": 120
                                                },
                                                "file_size": {
                                                    "description": "File size in bytes",
                                                    "type": "integer",
                                                    "example": 5242880
                                                },
                                                "checksum": {
                                                    "description": "SHA256 checksum",
                                                    "type": "string",
                                                    "example": "a1b2c3d4e5f6..."
                                                },
                                                "release_notes": {
                                                    "description": "Release notes",
                                                    "type": "string",
                                                    "example": "Bug fixes and performance improvements"
                                                },
                                                "is_force_update": {
                                                    "description": "Whether update is forced",
                                                    "type": "boolean",
                                                    "example": false
                                                },
                                                "released_at": {
                                                    "description": "Release date",
                                                    "type": "string",
                                                    "format": "date-time",
                                                    "example": "2025-11-09T00:00:00Z"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "No version available",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "No version available"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/login": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Login",
                "description": "Authenticate user and return JWT token. Device fingerprint is automatically generated from request headers. For Python clients, generate fingerprint using: import hashlib, platform, uuid; system_info = platform.platform() + platform.machine() + str(uuid.getnode()); fingerprint = 'device_' + hashlib.sha256(system_info.encode()).hexdigest()[:12]",
                "operationId": "dd51a484b7fa0f97c7680fdbde14cf5f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "username",
                                    "password"
                                ],
                                "properties": {
                                    "username": {
                                        "type": "string",
                                        "example": "admin"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "admin123"
                                    },
                                    "device_name": {
                                        "description": "Optional device name for identification",
                                        "type": "string",
                                        "example": "My Laptop"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Login successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Login successful"
                                        },
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer"
                                                },
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer"
                                                        },
                                                        "username": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        },
                                                        "email": {
                                                            "type": "string"
                                                        },
                                                        "role": {
                                                            "type": "string"
                                                        },
                                                        "status": {
                                                            "type": "string"
                                                        },
                                                        "device_limit": {
                                                            "type": "integer"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "device": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "string"
                                                        },
                                                        "name": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid credentials",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Invalid credentials"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Account suspended",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Account is suspended or banned"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Validation error"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/auth/validate": {
            "get": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Validate Token",
                "description": "Validate JWT token and return user info",
                "operationId": "01d8c7c7501dac83ce4b62e888780d5f",
                "responses": {
                    "200": {
                        "description": "Token is valid",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Token is valid"
                                        },
                                        "data": {
                                            "properties": {
                                                "user": {
                                                    "properties": {
                                                        "id": {
                                                            "type": "integer"
                                                        },
                                                        "username": {
                                                            "type": "string"
                                                        },
                                                        "role": {
                                                            "type": "string"
                                                        },
                                                        "status": {
                                                            "type": "string"
                                                        }
                                                    },
                                                    "type": "object"
                                                },
                                                "expires_at": {
                                                    "type": "string",
                                                    "format": "date-time"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Token invalid or expired",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Token is invalid or expired"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/refresh": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "Refresh Token",
                "description": "Refresh JWT token and get new token",
                "operationId": "30c20c52f5f72828d8c531fd7c9ea3e7",
                "responses": {
                    "200": {
                        "description": "Token refreshed successfully",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Token refreshed successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "token": {
                                                    "type": "string"
                                                },
                                                "token_type": {
                                                    "type": "string",
                                                    "example": "bearer"
                                                },
                                                "expires_in": {
                                                    "type": "integer"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Could not refresh token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Could not refresh token"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/auth/logout": {
            "post": {
                "tags": [
                    "Authentication"
                ],
                "summary": "User Logout",
                "description": "Logout user and blacklist JWT token",
                "operationId": "df9bdc6c7a6d9f20b983526b2ec0f698",
                "responses": {
                    "200": {
                        "description": "Successfully logged out",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Successfully logged out"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Could not logout",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Could not logout"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/email/submit": {
            "post": {
                "tags": [
                    "Email Submission"
                ],
                "summary": "Submit successful email registration",
                "description": "Submit details of successfully created email account with registration time tracking. Device fingerprint should be generated by client using: import hashlib, platform, uuid; system_info = platform.platform() + platform.machine() + str(uuid.getnode()); fingerprint = 'device_' + hashlib.sha256(system_info.encode()).hexdigest()[:12]",
                "operationId": "2081724902b9db23e89d49c21962ab75",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "device_fingerprint"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "testuser123@gmail.com"
                                    },
                                    "recovery_email": {
                                        "description": "Recovery email for account recovery",
                                        "type": "string",
                                        "format": "email",
                                        "example": "recovery123@gmail.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "SecurePass123!"
                                    },
                                    "registration_time": {
                                        "description": "Time in seconds from start to successful registration (optional, defaults to 0)",
                                        "type": "integer",
                                        "example": 3600
                                    },
                                    "device_fingerprint": {
                                        "description": "Unique device identifier for tracking which device registered the email",
                                        "type": "string",
                                        "example": "device_abc123xyz"
                                    },
                                    "proxy_info": {
                                        "description": "Proxy information (optional)",
                                        "properties": {
                                            "ip": {
                                                "type": "string",
                                                "example": "192.168.1.100"
                                            },
                                            "port": {
                                                "type": "integer",
                                                "example": 8080
                                            },
                                            "username": {
                                                "type": "string",
                                                "example": "proxy_user"
                                            },
                                            "password": {
                                                "type": "string",
                                                "example": "proxy_pass"
                                            }
                                        },
                                        "type": "object"
                                    },
                                    "metadata": {
                                        "properties": {
                                            "user_agent": {
                                                "type": "string",
                                                "example": "Mozilla/5.0..."
                                            },
                                            "creation_time": {
                                                "type": "string",
                                                "format": "date-time",
                                                "example": "2025-10-24T21:30:00Z"
                                            },
                                            "verification_status": {
                                                "type": "string",
                                                "example": "verified"
                                            },
                                            "notes": {
                                                "type": "string",
                                                "example": "Account created successfully"
                                            }
                                        },
                                        "type": "object"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Email submission successful",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Email account submitted successfully"
                                        },
                                        "data": {
                                            "properties": {
                                                "registration_id": {
                                                    "type": "integer",
                                                    "example": 123
                                                },
                                                "email": {
                                                    "type": "string",
                                                    "example": "testuser123@gmail.com"
                                                },
                                                "status": {
                                                    "type": "string",
                                                    "example": "success"
                                                },
                                                "registration_time": {
                                                    "type": "integer",
                                                    "example": 3600
                                                },
                                                "submitted_at": {
                                                    "type": "string",
                                                    "format": "date-time"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Validation error"
                                        },
                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Unauthorized"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Quota exceeded",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": false
                                        },
                                        "message": {
                                            "type": "string",
                                            "example": "Monthly quota exceeded"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "parameters": {
            "ApiVersion": {
                "name": "X-API-Version",
                "in": "header",
                "description": "API Version",
                "required": true,
                "schema": {
                    "type": "string",
                    "example": "1.0.0"
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "App Version Management",
            "description": "App Version Management"
        },
        {
            "name": "Authentication",
            "description": "Authentication"
        },
        {
            "name": "Email Submission",
            "description": "Email Submission"
        }
    ]
}